# Sent with every page: what the pages may load and where they may be shown.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://backhaul-gate.seventh-well.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  X-Frame-Options: DENY

# Files whose names change with their content can be kept by browsers for good.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
