// backhaul gate: hands out what a PC needs to join a Zoom meeting, to PCs with a licence.
// The Zoom keys and the admin token are Worker secrets (never in this file):
//   ZOOM_CLIENT_ID, ZOOM_CLIENT_SECRET, ADMIN_TOKEN,
//   SIGNIN_KEY (random text, 32 characters or more; seals the licences' Zoom sign-ins and undelivered keys)
// Selling needs three more secrets: STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, RESEND_API_KEY.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "backhaul-gate",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "routes": [{ "pattern": "backhaul-gate.seventh-well.com/*", "zone_name": "seventh-well.com" }],
  "vars": {
    "PUBLIC_URL": "https://backhaul-gate.seventh-well.com",
    // Selling. BILLING_URL is Stripe's sign-in page for subscribers; this one belongs to the
    // test environment ("test_" in it) and is replaced when real payments are switched on.
    "SITE_URL": "https://backhaul.seventh-well.com",
    "MAIL_FROM": "backhaul <info@seventh-well.com>",
    "BILLING_URL": "https://billing.stripe.com/p/login/test_aFadR8emVbTy4gugmU6oo00"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "backhaul-gate", "database_id": "D1_ID_FILLED_IN_BY_THE_DEPLOY_WORKFLOW", "migrations_dir": "migrations" }
  ],
  "observability": { "enabled": true }
}
